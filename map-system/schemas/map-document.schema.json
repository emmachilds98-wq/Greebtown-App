{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greebtown.local/schemas/map-document.schema.json",
  "title": "Greebtown map document",
  "type": "object",
  "required": ["schemaVersion", "documentId", "coordinateSystem", "layers", "objects"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^1\\.0\\.0$" },
    "documentId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "coordinateSystem": {
      "type": "object",
      "required": ["name", "unit", "origin", "xRange", "yRange"],
      "properties": {
        "name": { "const": "schematic-percent-v1" },
        "unit": { "const": "map-unit" },
        "origin": { "const": "top-left" },
        "xRange": { "$ref": "#/$defs/range" },
        "yRange": { "$ref": "#/$defs/range" }
      }
    },
    "layers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/layer" } },
    "objects": { "type": "array", "items": { "$ref": "#/$defs/mapObject" } }
  },
  "$defs": {
    "range": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
    "layer": {
      "type": "object",
      "required": ["id", "name", "order", "visible", "locked"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string" },
        "order": { "type": "number" },
        "visible": { "type": "boolean" },
        "locked": { "type": "boolean" }
      }
    },
    "mapObject": {
      "type": "object",
      "required": ["id", "type", "name", "position", "dimensions", "transform", "layer", "asset", "metadata"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "type": { "enum": ["terrain", "district", "building", "stage", "vendor", "toilet", "medical", "camping", "entrance", "exit", "path", "boundary", "decoration", "hidden-location"] },
        "name": { "type": "string", "minLength": 1 },
        "position": { "$ref": "#/$defs/point" },
        "dimensions": { "$ref": "#/$defs/dimensions" },
        "transform": { "$ref": "#/$defs/transform" },
        "layer": { "type": "string" },
        "asset": { "type": ["string", "null"] },
        "metadata": { "type": "object" }
      }
    },
    "point": { "type": "object", "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
    "dimensions": { "type": "object", "required": ["width", "height"], "properties": { "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } } },
    "transform": { "type": "object", "required": ["rotation", "scale"], "properties": { "rotation": { "type": "number" }, "scale": { "type": "number", "exclusiveMinimum": 0 } } }
  }
}
