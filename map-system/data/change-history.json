        { "objectId": "district-letsbe-avenue", "field": "reference anchor", "previous": [38, 31], "next": [34, 30] },
        { "objectId": "camp-campervan", "field": "position", "previous": [86, 14], "next": [93, 41], "note": "moved south of Anara Forest to sit with East Camping/East Gate, per findings_screenshots.md" },
        { "objectId": "TRUNK_PATH_EDGES", "field": "js/app.js", "previous": "West Camping, Valley Camping, Tangerine Fields, Campervan Field, East Camping, Meadow Camping (Accessible), Meadow Living, Camplight, Quiet Camping had no path edge at all", "next": "each connected to its nearest evidenced gate/junction" }
      ]
    },
    {
      "id": "hilltop-ratio-correction-2026-08-10T144500Z",
      "timestamp": "2026-08-10T14:45:00Z",
      "actor": "claude",
