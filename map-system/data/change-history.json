    {
      "id": "recalibrate-outer-zoning-2026-08-10T140000Z",
      "timestamp": "2026-08-10T14:00:00Z",
      "actor": "claude",
      "summary": "Direct user feedback that Hilltop Field, Lion's Den, Letsbe Avenue and several perimeter camps were sized/positioned wrong, and that most camps had no path reaching them at all.",
      "changes": [
        { "objectId": "hilltop-field", "field": "points", "previous": "y-span 14-62 (48 units), reaching well north of Grand Central", "next": "y-span 27-62 (35 units), north tip trimmed back to Grand Central's own latitude" },
