rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Greebtown's current app uses one fixed shared room and stores one
    // complete snapshot per device at:
    // rooms/medway-massive/members/{deviceId}
    //
    // There is deliberately no Firebase Auth in this app, so this is not
    // an identity boundary. The room code acts as the shared access secret.
    // Keep it out of public posts and change it in BOTH this file and
    // js/app.js if the group code ever changes.

    match /rooms/medway-massive/members/{memberId} {
      allow read: if true;

      // The app replaces the whole member document on every sync. Only
      // these top-level fields are accepted, which stops arbitrary data
      // being written elsewhere in the document.
      allow create, update: if
        request.resource.data.keys().hasOnly([
          'v',
          'deviceId',
          'from',
          'clues',
          'characterNotes',
          'theories',
          'hiddenVenues',
          'involvedDone',
          'discoveries',
          'customSocials',
          'quotes',
          'sightings',
          'customLandmarks',
          'customPlaces',
          'officialTimeCorrections',
          'schedule',
          'bingo',
          'character',
          'status',
          'meeting',
          'decisions',
          'activities',
          'joinedActivities',
          'wantTogether',
          'updatedAt'
        ])
        && request.resource.data.v == 1
        && request.resource.data.deviceId == memberId
        && request.resource.data.from is string
        && request.resource.data.updatedAt is int;

      // Needed for the app's old-room/device cleanup. Deleting a document
      // is safe here because only this fixed room is matched.
      allow delete: if true;

      // Snapshot-history backups of this one member's own doc, written by
      // snapshotBackupIfDue()/takeManualBackupNow() in js/app.js. Each doc
      // is immutable once created (create-only, no update) and is pruned
      // by the app itself once older than the newest BACKUP_MAX_SNAPSHOTS
      // (pinned ones excluded from that prune), so delete is allowed the
      // same way it is on the parent member doc above. 'pinned' is
      // optional — only manual backups (takeManualBackupNow) set it.
      match /backups/{backupId} {
        allow read: if true;
        allow create: if
          request.resource.data.keys().hasOnly(['takenAt', 'payload', 'pinned'])
          && request.resource.data.takenAt is int
          && request.resource.data.payload.keys().hasOnly([
            'v','deviceId','from','clues','characterNotes','theories',
            'hiddenVenues','involvedDone','discoveries','customSocials',
            'quotes','sightings','customLandmarks','customPlaces','officialTimeCorrections','schedule','bingo',
            'character','status','meeting','decisions','activities',
            'joinedActivities','wantTogether','updatedAt'
          ]);
        allow update: if false;
        allow delete: if true;
      }
    }

    // Local chat — group + 1:1 messages, plus a lightweight per-device
    // presence/read-receipt doc. Sibling collections to rooms/medway-
    // massive/members above, not nested under a specific member, since a
    // message belongs to a thread (the whole group, or a pair of people),
    // not to any one person's own sync doc. Same trust model as
    // everything else in this file: no Firebase Auth, so this only
    // validates document SHAPE, not who's allowed to write it — the room
    // code is the access secret. See js/app.js's LOCAL CHAT section.
    match /rooms/medway-massive/chatMessages/{messageId} {
      allow read: if true;

      // Messages are immutable once sent (no edit) — only ever created
      // by sendChatMessage() or removed by this app's own history-
      // pruning (pruneChatThreadIfNeeded, keeps a bounded number per
      // thread), the same "delete is safe here, only this fixed room is
      // matched" reasoning as the members doc above.
      allow create: if
        request.resource.data.keys().hasOnly(['thread','text','fromName','fromDeviceId','ts'])
        && request.resource.data.thread is string && request.resource.data.thread.size() < 200
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() < 2000
        && request.resource.data.fromName is string && request.resource.data.fromName.size() < 60
        && request.resource.data.fromDeviceId is string
        && request.resource.data.ts is int;
      allow update: if false;
      allow delete: if true;
    }

    // One doc per device: displayName/lastActiveAt for the online dot
    // (sendChatHeartbeat), reads for per-thread read receipts
    // (markThreadRead). Doc id is that device's own deviceId, matching
    // the members doc convention, though — same caveat as everywhere
    // else here — nothing enforces a device only ever writes its own id,
    // since there's no auth to check it against.
    match /rooms/medway-massive/chatPresence/{deviceId} {
      allow read: if true;
      allow create, update: if
        request.resource.data.keys().hasOnly(['displayName','lastActiveAt','reads'])
        && (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() < 60))
        && (!('lastActiveAt' in request.resource.data) || request.resource.data.lastActiveAt is int)
        && (!('reads' in request.resource.data) || request.resource.data.reads is map);
      allow delete: if true;
    }

    // One doc per device: its current FCM Web Push registration token,
    // written by registerPushToken() in js/app.js whenever notifications
    // are turned on (or the token rotates). Read by the sendChatPush
    // Cloud Function (functions/index.js) via the Admin SDK, which
    // bypasses these rules entirely — this match only ever gates the
    // client's own write. Doc id is that device's own deviceId, same
    // convention (and same no-auth caveat) as chatPresence above.
    match /rooms/medway-massive/pushTokens/{deviceId} {
      allow read: if true;
      allow create, update: if
        request.resource.data.keys().hasOnly(['deviceId','displayName','token','updatedAt'])
        && request.resource.data.deviceId == deviceId
        && request.resource.data.token is string
        && (!('displayName' in request.resource.data) || request.resource.data.displayName is string)
        && request.resource.data.updatedAt is int;
      allow delete: if true;
    }

    // Nothing else in the Firestore database is exposed to the public app.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
